# Optional: override the embedding model used for document search (RAG)
# OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Server mode (server/server.sh; see README → Running as a server) ──

# The public address Tailscale Funnel gives you, without https://
# e.g. my-mac.tail1234.ts.net — invite and reset links use it.
# UNESS_PUBLIC_HOST=

# Ports: at this Mac (no sign-in), and the one Funnel forwards to
# UNESS_LOCAL_PORT=8000
# UNESS_PUBLIC_PORT=8100

# Username of the owner account (created on first start)
# UNESS_OWNER=owner

# Limits (comments must be on their own line — this file has no inline comments)
# Largest file anyone can upload, in MB
# UNESS_MAX_UPLOAD_MB=25
# A single answer is stopped after this many seconds
# UNESS_MAX_JOB_SECONDS=600
# Requests one person can have in progress at once
# UNESS_MAX_JOBS_PER_USER=1
# Pause between back-to-back jobs, so each prompt's energy reading is clean
# UNESS_QUEUE_GAP_SECONDS=2
# How long the model stays loaded after the last prompt (Ollama duration, e.g. 60m, 24h, -1 = always)
# UNESS_KEEP_ALIVE=60m

# Keep the Mac from sleeping while the server runs (1 = yes)
# UNESS_KEEP_AWAKE=1

# Only for unusual dev setups that call the API from another origin
# UNESS_CORS_ORIGINS=
